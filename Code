
#include <Wire.h>
#include <Adafruit_PWMServoDriver.h>
#include "Adafruit_TCS34725.h"
#include <LiquidCrystal_I2C.h>

// ================= PCA9685 =================
Adafruit_PWMServoDriver pca = Adafruit_PWMServoDriver(0x40);

// ================= LCD =================
LiquidCrystal_I2C lcd(0x27, 16, 2);

// ================= COLOR SENSOR =================
Adafruit_TCS34725 tcs = Adafruit_TCS34725(
  TCS34725_INTEGRATIONTIME_154MS,
  TCS34725_GAIN_16X
);

// ================= SERVO CHANNELS =================
#define BASE 0
#define SHOULDER 1
#define WRIST 2
#define GRIPPER 3

// ================= SERVO PWM =================
#define SERVOMIN 150
#define SERVOMAX 600

// ================= SERVO POSITIONS =================
int basePos = 90;
int shoulderPos = 50;
int wristPos = 90;
int gripperPos = 30;

// ================= MOVEMENT SETTINGS =================
const int stepDelay = 25;
const int stepSize = 2;

// ================= COLOR SETTINGS =================
const int OBJECT_THRESHOLD = 80;

// ================= ANGLE CONVERSION =================
int angleToPulse(int angle) {
  return map(constrain(angle, 0, 180), 0, 180,
             SERVOMIN, SERVOMAX);
}

// ================= SMOOTH MOVEMENT =================
void smoothMove(int ch, int &cur, int target) {

  target = constrain(target, 0, 180);

  if (cur < target) {
    for (int i = cur; i < target; i += stepSize) {
      pca.setPWM(ch, 0, angleToPulse(i));
      delay(stepDelay);
    }
  }
  else {
    for (int i = cur; i > target; i -= stepSize) {
      pca.setPWM(ch, 0, angleToPulse(i));
      delay(stepDelay);
    }
  }

  pca.setPWM(ch, 0, angleToPulse(target));
  cur = target;
}

// ================= LCD DISPLAY =================
void displayMessage(const char* line1, const char* line2) {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print(line1);
  lcd.setCursor(0, 1);
  lcd.print(line2);
}

// ================= SETUP =================
void setup() {

  Serial.begin(9600);
  Wire.begin();

  // Initialize LCD
  lcd.init();
  lcd.backlight();

  displayMessage("Initializing...", "Please wait");

  // Initialize PCA9685
  pca.begin();
  pca.setPWMFreq(50);
  delay(500);

  // Initialize Color Sensor
  if (!tcs.begin()) {
    displayMessage("Sensor Error!", "Check TCS34725");

    Serial.println("TCS34725 not detected!");

    while (true) {
      delay(1000);
    }
  }

  Serial.println("Color Sorting System Ready");

  displayMessage("System Ready", "Color Sorting");

  goToCenter();

  delay(1000);
}

// ================= MAIN LOOP =================
void loop() {

  // Return to pickup position
  goToCenter();

  displayMessage("Waiting for", "Pill/Object");

  delay(500);

  // Read color sensor
  uint16_t r, g, b, c;

  tcs.getRawData(&r, &g, &b, &c);

  Serial.print("R: "); Serial.print(r);
  Serial.print(" G: "); Serial.print(g);
  Serial.print(" B: "); Serial.print(b);
  Serial.print(" C: "); Serial.println(c);

  // ================= OBJECT DETECTION =================
  if (c < OBJECT_THRESHOLD) {
    displayMessage("No Object", "Waiting...");
    delay(500);
    return;
  }

  // ================= COLOR NORMALIZATION =================
  float sum = (float)r + g + b;

  if (sum <= 0) {
    displayMessage("Invalid Color", "Try Again");
    delay(500);
    return;
  }

  float rn = r / sum;
  float gn = g / sum;
  float bn = b / sum;

  bool isRed =
    (rn > gn && rn > bn && rn > 0.40);

  bool isGreen =
    (gn > rn && gn > bn && gn > 0.40);

  bool isBlue =
    (bn > rn && bn > gn && bn > 0.20);

  // ================= UNKNOWN COLOR =================
  if (!isRed && !isGreen && !isBlue) {

    displayMessage("Unknown Color", "Not Sorted");

    delay(1000);
    return;
  }

  // ================= PICK UP OBJECT =================
  displayMessage("Object Found", "Gripping...");

  gripObject();

  delay(300);

  // ================= COLOR SORTING =================

  if (isRed) {

    displayMessage("Color: RED", "Sorting...");

    moveToBin(30, 100, 120);
  }

  else if (isGreen) {

    displayMessage("Color: GREEN", "Sorting...");

    moveToBin(90, 100, 100);
  }

  else if (isBlue) {

    displayMessage("Color: BLUE", "Sorting...");

    moveToBin(150, 100, 80);
  }

  // ================= RELEASE OBJECT =================
  displayMessage("Releasing", "Object...");

  releaseObject();

  delay(500);

  // ================= RETURN TO CENTER =================
  displayMessage("Returning", "To Center...");

  goToCenter();

  displayMessage("Sorting Done", "Next Object");

  delay(1500);
}

// ================= CENTER POSITION =================
void goToCenter() {

  smoothMove(BASE, basePos, 90);
  smoothMove(SHOULDER, shoulderPos, 50);
  smoothMove(WRIST, wristPos, 90);
  smoothMove(GRIPPER, gripperPos, 30);
}

// ================= GRIP OBJECT =================
void gripObject() {

  smoothMove(GRIPPER, gripperPos, 0);

  delay(800);
}

// ================= RELEASE OBJECT =================
void releaseObject() {

  smoothMove(GRIPPER, gripperPos, 30);

  delay(800);
}

// ================= MOVE TO BIN =================
void moveToBin(int b, int s, int w) {

  // STEP 1: LIFT THE OBJECT FIRST
  // Adjust these angles based on your actual arm.
  smoothMove(SHOULDER, shoulderPos, 30);
  smoothMove(WRIST, wristPos, 60);

  delay(500);

  // STEP 2: ROTATE BASE AFTER LIFTING
  smoothMove(BASE, basePos, b);

  delay(500);

  // STEP 3: LOWER ARM TOWARD THE BIN
  smoothMove(SHOULDER, shoulderPos, s);
  smoothMove(WRIST, wristPos, w);

  delay(500);
}
